# Deployment settings. Copy to .env (gitignored) and fill in.
# Read by deploy.sh and scripts/upload_pmtiles.sh.

# Google Cloud project and region
GCP_PROJECT=
GCP_REGION=
# Artifact Registry repository and Cloud Run service
ARTIFACT_REPO=
CLOUD_RUN_SERVICE=

# Private GCS bucket holding pmtiles/ (Cloud Run serves it at /api/pmtiles/)
TILE_STORE_BUCKET=
