# Deployment settings. Copy to .env (gitignored) and fill in.
# Read by deploy.sh and scripts/*.sh via scripts/env.sh.

# Google Cloud project and region
GCP_PROJECT=
GCP_REGION=
# Artifact Registry repository and Cloud Run service
ARTIFACT_REPO=
CLOUD_RUN_SERVICE=

# GCS bucket holding pmtiles/ (served to the browser via range requests)
TILE_STORE_BUCKET=
