# Deployment settings: identifiers only, no secrets. Tracked in git.
# deploy.sh and scripts/upload_pmtiles.sh load this, then an optional gitignored .env
# on top (see .env.example). Credentials never go here: gcloud and Cloud Run supply them.
GCP_PROJECT=vacant-lot-detection
GCP_REGION=us-east1
ARTIFACT_REPO=vacant-lots-webapp
CLOUD_RUN_SERVICE=vacant-lot-app

# Private GCS bucket holding pmtiles/ (Cloud Run serves it at /api/pmtiles/)
TILE_STORE_BUCKET=vacant-lots-webapp

# Cloud Run sizing
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_MIN_INSTANCES=1
WEB_WORKERS=2
